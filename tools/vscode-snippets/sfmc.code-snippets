{
  "AMPscript block": {
    "prefix": "amp-block",
    "description": "AMPscript block with VAR and SET",
    "body": [
      "%%[",
      "VAR @${1:name}",
      "SET @${1:name} = ${2:value}",
      "$0",
      "]%%"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript Lookup": {
    "prefix": "amp-lookup",
    "description": "Lookup one value from a data extension",
    "body": [
      "SET @${1:value} = Lookup(\"${2:My_DE}\", \"${3:ReturnField}\", \"${4:SubscriberKey}\", ${5:_subscriberkey})"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript LookupOrderedRows loop": {
    "prefix": "amp-rows",
    "description": "Loop over the newest N rows of a data extension",
    "body": [
      "%%[",
      "VAR @rows, @count, @i, @row",
      "SET @rows = LookupOrderedRows(\"${1:My_DE}\", ${2:5}, \"${3:CreatedAt} DESC\", \"${4:SubscriberKey}\", ${5:_subscriberkey})",
      "SET @count = RowCount(@rows)",
      "IF @count > 0 THEN",
      "  FOR @i = 1 TO @count DO",
      "    SET @row = Row(@rows, @i)",
      "    $0",
      "  NEXT @i",
      "ENDIF",
      "]%%"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript fallback": {
    "prefix": "amp-fallback",
    "description": "Fallback for an empty attribute, with proper case",
    "body": [
      "%%[",
      "VAR @${1:firstName}",
      "SET @${1:firstName} = AttributeValue(\"${2:FirstName}\")",
      "IF Empty(@${1:firstName}) THEN",
      "  SET @${1:firstName} = \"${3:there}\"",
      "ELSE",
      "  SET @${1:firstName} = ProperCase(@${1:firstName})",
      "ENDIF",
      "]%%"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript local date": {
    "prefix": "amp-date",
    "description": "Local date formatted by culture",
    "body": [
      "%%=FormatDate(DateAdd(SystemDateToLocalDate(Now()), ${1:7}, \"D\"), \"${2:dd/MM/yyyy}\", \"\", \"${3:pt-BR}\")=%%"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript tracked link": {
    "prefix": "amp-link",
    "description": "Tracked link with encoded parameters",
    "body": [
      "%%[ SET @${1:url} = Concat(\"${2:https://example.com/page}\", \"?id=\", URLEncode(_subscriberkey, 1, 1)) ]%%",
      "<a href=\"%%=RedirectTo(@${1:url})=%%\" alias=\"${3:cta}\">${4:Link text}</a>"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript CloudPagesURL": {
    "prefix": "amp-cloudpage",
    "description": "Link to a CloudPage with encrypted (non-identity) parameters. For identities use amp-signed-link",
    "body": [
      "<a href=\"%%=RedirectTo(CloudPagesURL(${1:1234}, \"${2:campaign}\", \"${3:value}\"))=%%\" alias=\"${4:cta}\">${5:Open page}</a>"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript RaiseError skip": {
    "prefix": "amp-skip",
    "description": "Skip the send for this contact when data is missing",
    "body": [
      "%%[",
      "IF Empty(@${1:value}) THEN",
      "  RaiseError(\"${2:Missing data}\", true)",
      "ENDIF",
      "]%%"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript CloudPage POST guard": {
    "prefix": "amp-post",
    "description": "Process a CloudPage form only on a real submission",
    "body": [
      "%%[",
      "VAR @submitted",
      "SET @submitted = RequestParameter(\"submitted\")",
      "IF @submitted == \"1\" THEN",
      "  $0",
      "ENDIF",
      "]%%",
      "<form method=\"post\" action=\"%%=RequestParameter('PAGEURL')=%%\">",
      "  <input type=\"hidden\" name=\"submitted\" value=\"1\">",
      "  <button type=\"submit\">${1:Send}</button>",
      "</form>"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript UpsertData": {
    "prefix": "amp-upsert",
    "description": "Insert or update one row",
    "body": [
      "UpsertData(\"${1:My_DE}\", 1, \"${2:SubscriberKey}\", ${3:@key}, \"${4:Field}\", ${5:@value}, \"UpdatedAt\", Now())"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "AMPscript ClaimRowValue": {
    "prefix": "amp-claim",
    "description": "Assign one unused code (coupon) to this contact",
    "body": [
      "SET @${1:coupon} = ClaimRowValue(\"${2:Coupons_DE}\", \"${3:CouponCode}\", \"IsClaimed\", \"\", \"SubscriberKey\", ${4:_subscriberkey})"
    ],
    "scope": "html,ampscript,plaintext"
  },
  "SSJS block": {
    "prefix": "ssjs-block",
    "description": "Server-side JavaScript block",
    "body": [
      "<script runat=\"server\">",
      "Platform.Load(\"core\", \"1.1.5\");",
      "$0",
      "</script>"
    ],
    "scope": "html,javascript,plaintext"
  },
  "SSJS try/catch log": {
    "prefix": "ssjs-try",
    "description": "try/catch that logs to a DE and re-throws so the Automation still fails",
    "body": [
      "try {",
      "  $0",
      "} catch (e) {",
      "  var msg = String(Stringify(e)).substring(0, 3990);",
      "  try { DataExtension.Init(\"${1:Error_Log_DE}\").Rows.Add({ Source: \"${2:Script_Name}\", Message: msg, CreatedAt: Platform.Function.Now() }); } catch (logErr) {}",
      "  throw e;",
      "}"
    ],
    "scope": "html,javascript,plaintext"
  },
  "SSJS WSProxy retrieve all": {
    "prefix": "ssjs-retrieve",
    "description": "Retrieve every row of a DE with WSProxy pagination",
    "body": [
      "var api = new Script.Util.WSProxy();",
      "var objectType = \"DataExtensionObject[${1:My_DE}]\";",
      "var res = api.retrieve(objectType, [${2:\"SubscriberKey\"}]);",
      "var rows = [];",
      "while (true) {",
      "  for (var i = 0; i < res.Results.length; i++) {",
      "    var props = res.Results[i].Properties, row = {};",
      "    for (var p = 0; p < props.length; p++) { row[props[p].Name] = props[p].Value; }",
      "    rows.push(row);",
      "  }",
      "  if (!res.HasMoreRows) break;",
      "  res = api.getNextBatch(objectType, res.RequestID);",
      "}"
    ],
    "scope": "html,javascript,plaintext"
  },
  "SQL dedup ROW_NUMBER": {
    "prefix": "sql-dedup",
    "description": "Keep the newest row per key",
    "body": [
      "SELECT x.${1:SubscriberKey}, x.${2:EmailAddress}",
      "FROM (",
      "    SELECT ${1:SubscriberKey}, ${2:EmailAddress},",
      "           ROW_NUMBER() OVER (PARTITION BY ${1:SubscriberKey} ORDER BY ${3:UpdatedAt} DESC) AS rn",
      "    FROM [${4:Source_DE}]",
      ") x",
      "WHERE x.rn = 1"
    ],
    "scope": "sql,plaintext"
  },
  "SQL anti-join": {
    "prefix": "sql-anti",
    "description": "Exclude keys found in a staging DE",
    "body": [
      "SELECT a.${1:SubscriberKey}",
      "FROM [${2:Audience_DE}] a",
      "LEFT JOIN [${3:Exclusion_Staging_DE}] e ON e.${1:SubscriberKey} = a.${1:SubscriberKey}",
      "WHERE e.${1:SubscriberKey} IS NULL"
    ],
    "scope": "sql,plaintext"
  },
  "SQL frequency cap": {
    "prefix": "sql-freqcap",
    "description": "Remove contacts with N+ sends in the last D days",
    "body": [
      "SELECT a.SubscriberKey, a.EmailAddress",
      "FROM [${1:Audience_DE}] a",
      "LEFT JOIN (",
      "    SELECT SubscriberKey FROM _Sent",
      "    WHERE EventDate >= DATEADD(DAY, -${2:7}, GETDATE())",
      "    GROUP BY SubscriberKey",
      "    HAVING COUNT(*) >= ${3:3}",
      ") f ON f.SubscriberKey = a.SubscriberKey",
      "WHERE f.SubscriberKey IS NULL"
    ],
    "scope": "sql,plaintext"
  },
  "SQL last N days of a Data View": {
    "prefix": "sql-recent",
    "description": "Rows from a tracking Data View in the last N days",
    "body": [
      "SELECT SubscriberKey, JobID, EventDate",
      "FROM ${1|_Sent,_Open,_Click,_Bounce,_Unsubscribe|}",
      "WHERE EventDate >= DATEADD(DAY, -${2:30}, GETDATE())"
    ],
    "scope": "sql,plaintext"
  },
  "AMPscript signed CloudPage link": {
    "prefix": "amp-signed-link",
    "scope": "html,ampscript,plaintext",
    "description": "CloudPagesURL with subscriber key + SHA256 signature",
    "body": [
      "%%[",
      "SET @secret = Lookup(\"Config_DE\", \"Value\", \"Name\", \"LINK_SIGNING_SECRET\")",
      "SET @sig = SHA256(Concat(_subscriberkey, \"|\", @secret), \"UTF-8\")",
      "]%%",
      "<a href=\"%%=RedirectTo(CloudPagesURL(${1:1234}, \"sk\", _subscriberkey, \"sig\", @sig))=%%\" alias=\"${2:cta}\">${3:Open}</a>"
    ]
  },
  "AMPscript verify signature": {
    "prefix": "amp-verify-sig",
    "scope": "html,ampscript,plaintext",
    "description": "On a CloudPage: accept sk only with a valid signature",
    "body": [
      "%%[",
      "SET @sk = RequestParameter(\"sk\")",
      "SET @secret = Lookup(\"Config_DE\", \"Value\", \"Name\", \"LINK_SIGNING_SECRET\")",
      "IF Empty(@sk) OR Empty(@secret) OR RequestParameter(\"sig\") != SHA256(Concat(@sk, \"|\", @secret), \"UTF-8\") THEN",
      "  SET @sk = \"\"",
      "ENDIF",
      "]%%"
    ]
  },
  "AMPscript allow-list": {
    "prefix": "amp-allow",
    "scope": "html,ampscript,plaintext",
    "description": "Allow-list a request value before printing or storing it",
    "body": [
      "SET @${1:value} = RegExMatch(RequestParameter(\"${2:param}\"), \"^[A-Za-z0-9_.-]{1,50}\\$\", 0)",
      "IF Empty(@${1:value}) THEN SET @${1:value} = \"${3:default}\" ENDIF"
    ]
  },
  "SSJS HttpRequest JSON": {
    "prefix": "ssjs-http",
    "scope": "html,javascript,plaintext",
    "description": "Script.Util.HttpRequest with JSON body and status check",
    "body": [
      "var req = new Script.Util.HttpRequest(\"${1:https://api.example.com/v1/items}\");",
      "req.emptyContentHandling = 0;",
      "req.retries = 1;",
      "req.continueOnError = true;",
      "req.method = \"${2|POST,GET,PUT,PATCH,DELETE|}\";",
      "req.contentType = \"application/json\";",
      "req.setHeader(\"Authorization\", \"Bearer \" + ${3:token});",
      "req.postData = Stringify(${4:payload});",
      "var resp = req.send();",
      "var status = Number(resp.statusCode);",
      "var body = Platform.Function.ParseJSON(String(resp.content));",
      "$0"
    ]
  },
  "SQL today in Brasilia": {
    "prefix": "sql-today-local",
    "scope": "sql,plaintext",
    "description": "Today's date in Brasília time (server is UTC-6)",
    "body": [
      "CAST(DATEADD(HOUR, ${1:3}, GETDATE()) AS DATE)"
    ]
  },
  "SQL tracking with journey": {
    "prefix": "sql-journey-join",
    "scope": "sql,plaintext",
    "description": "Join a tracking Data View to its journey",
    "body": [
      "SELECT j.JourneyID, j.JourneyName, ${1:s}.SubscriberKey, ${1:s}.EventDate",
      "FROM ${2|_Sent,_Open,_Click,_Bounce,_Unsubscribe|} ${1:s}",
      "INNER JOIN _JourneyActivity ja ON ja.JourneyActivityObjectID = ${1:s}.TriggererSendDefinitionObjectID",
      "INNER JOIN _Journey j ON j.VersionID = ja.VersionID",
      "WHERE ${1:s}.EventDate >= DATEADD(DAY, -${3:30}, GETDATE())"
    ]
  }
}